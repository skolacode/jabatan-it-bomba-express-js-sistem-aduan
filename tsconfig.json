{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler", // Fixes the .js import issue
    "moduleDetection": "force",
    
    "rootDir": "./src",
    "outDir": "./dist",
    
    "sourceMap": true,
    "declaration": true,
    
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    
    // Add these for Node support
    "lib": ["ESNext"],
    "types": ["node"] 
  }
}
